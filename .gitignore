# ── 依赖与构建产物 ──
/node_modules
/oh_modules
**/build
/.hvigor
/.cxx
/.appanalyzer
**/.test
/.clangd
/.clang-format
/.clang-tidy
# CI 用的 command-line-tools 压缩包（2.2GB，误提交会撑爆 .git）
*.zip

# ── IDE 与工具本地数据 ──
/.idea
/.deveco
/.codegraph
/.vscode
/local.properties

# ── 签名凭据（切勿提交）──
# 应用签名密钥库与证书属于个人凭据，一旦泄露可被用于签署冒名应用。
sign/
*.p12
*.p7b
*.csr
*.cer
*.jks
*.keystore
/build-profile.json5

# ── 本地调试产物（日志 / 截图 / UI dump / 崩溃转储）──
/_*
!_start.bat
*.log
*.dmp
*.patch
/_archive/
# 根目录临时截图与 uitest dumpLayout 输出
/*.jpeg
/*.jpg
/*.png
/*.json
# Python 脚本缓存
__pycache__/
*.pyc

# ── AI 工具与会话数据 ──
/.workbuddy/
/.zcode/
/.codeartsdoer/
/.atomcode/
/.merkle-snapshot.json

# ── 本地设计稿与临时图 ──
/design-refs/
/generated-images/
/cq/

# Local signing configuration and privacy verification captures
/.local/
# 验收材料目录（UI dump、截图、构建日志）整体不入库，仅 docs/ 留存结论
/artifacts/

# 本地协作、过程文档和验证材料（不随源码发布）
